# Tiêu đề bảo mật HTTP cho cả web gravitispace.com (trang chính, /stars/, /privacy/, /admin/).
# Cloudflare Pages (và Netlify) chỉ đọc tệp _headers ở GỐC web, nên mọi quy tắc nằm ở đây.
# Lưu ý: nhiều quy tắc cùng khớp một đường dẫn thì tiêu đề bị CỘNG dồn. Vì vậy CSP chỉ đặt theo từng nhóm trang,
# không đặt ở /* (nếu không, CSP của trang chính sẽ chặn Graviti Stars gọi Supabase).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Trang chính và trang quyền riêng tư: không gọi máy chủ ngoài nào
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Cache-Control: no-cache
/privacy/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Graviti Stars: được gọi Supabase (tài khoản, đồng bộ). Phải khớp web/_headers (tests/hub.test.mjs kiểm tra).
/stars/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-d4qRMtpQ1V86X3YAjPkdTF3g2dp8LzjvNe3a9WRuRqM='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
/stars/sw.js
  Cache-Control: no-cache
/stars/index.html
  Cache-Control: no-cache

# Trang quản trị: gọi thêm GitHub API; không lập chỉ mục; không lưu đệm. Cổng chặn người lạ là Cloudflare Access.
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.github.com https://teedeetee13.github.io; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store
