{
  "name": "an-sao-space",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "An Sao Space — Tarot, chiêm tinh, tử vi theo hướng chữa lành. Web tĩnh, không phụ thuộc thư viện ngoài.",
  "scripts": {
    "start": "python -m http.server 5190 --directory web",
